{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:prod": "node dist/server/db/migrate.js",
    "db:seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "pg": "^8.22.0",
    "viem": "^2.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
