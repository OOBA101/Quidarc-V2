# ==========================================
# Quidarc Backend — Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://quidarc:quidarc_dev@localhost:5432/quidarc_dev

# Arc Blockchain RPC
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Circle Programmable Wallets API
CIRCLE_API_KEY=

# AI Orchestration (Anthropic Claude)
ANTHROPIC_API_KEY=

# CORS — comma-separated list of allowed frontend origins. Required in
# production; the deployed app and landing page origins go here, e.g.
# CORS_ORIGINS=https://app.quidarc.com,https://quidarc.com
# In development, local Vite dev servers are allowed automatically.
CORS_ORIGINS=
