# ==========================================
# Quidarc Backend — Environment Configuration
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:ADIqQZUhqIiuwGKsquTRhDsqaMrfbBmK@postgres.railway.internal:5432/railway

# Arc Blockchain RPC
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Circle Developer-Controlled Wallets (Agent Wallet provisioning + execution).
# Leave all three blank to run in labeled-mock mode (no real wallets). To enable
# real Agent Wallets on Arc Testnet, set all three together:
#   - CIRCLE_API_KEY: your Circle API key
#   - CIRCLE_ENTITY_SECRET: 32-byte entity secret (full signing authority — keep secret)
#   - CIRCLE_WALLET_SET_ID: the wallet set new Agent Wallets are created under
CIRCLE_API_KEY= 1c2ea1ff57644ace15d6d8d9839f1a4c:4fe3a33219ac63a74a8d071cddbbefdf
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# AI Orchestration — Anthropic Claude (intent classification + parameter extraction).
# Leave ANTHROPIC_API_KEY blank to run the orchestrator in labeled-mock mode (generic
# replies, no API calls). ANTHROPIC_MODEL is configurable so the deployment is never
# pinned to a model ID that later gets deprecated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=[REDACTED]

# CORS — comma-separated list of allowed frontend origins. Required in
# production; the deployed app and landing page origins go here, e.g.
# CORS_ORIGINS=https://app.quidarc.com,https://quidarc.com
# In development, local Vite dev servers are allowed automatically.
CORS_ORIGINS=
