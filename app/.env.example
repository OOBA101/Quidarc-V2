# ==========================================
# Quidarc Web App — Environment Configuration
# ==========================================

# Backend API base URL, INCLUDING the /api path.
# - Local development: leave unset. The Vite dev server proxies /api to the
#   backend at http://127.0.0.1:3001 automatically (see vite.config.ts).
# - Production: set to your deployed backend origin + /api, e.g.
#   https://quidarc-backend-production.up.railway.app/api
VITE_API_BASE_URL=

# Arc Testnet RPC endpoint used by the browser to sign and broadcast USDC
# transfers directly (the backend never sees User Wallet keys). Leave unset to
# use the official default (https://rpc.testnet.arc.network).
VITE_ARC_RPC_URL=

# Arc Testnet USDC contract address. Leave unset to use the system default
# (0x3600000000000000000000000000000000000000). Only override for a fork/mock.
VITE_ARC_USDC_CONTRACT_ADDRESS=
