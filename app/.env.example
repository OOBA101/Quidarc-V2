# ==========================================
# Quidarc Web App — Environment Configuration
# ==========================================

# Backend API base URL, INCLUDING the /api path.
# - Local development: leave unset. The Vite dev server proxies /api to the
#   backend at http://127.0.0.1:3001 automatically (see vite.config.ts).
# - Production: set to your deployed backend origin + /api, e.g.
#   https://quidarc-backend-production.up.railway.app/api
VITE_API_BASE_URL=
